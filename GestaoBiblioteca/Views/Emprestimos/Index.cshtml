@model IEnumerable<GestaoBiblioteca.Data.Entities.Emprestimo>

@{
    ViewData["Title"] = "Empréstimos";
}

<h1>Empréstimos</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">
        Novo Empréstimo
    </a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Leitor</th>
            <th>Livro</th>
            <th>Data do Empréstimo</th>
            <th>Devolução Prevista</th>
            <th>Data de Devolução</th>
            <th>Estado</th>
            <th></th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Leitor?.Nome</td>

                <td>@item.Livro?.Titulo</td>

                <td>
                    @item.DataEmprestimo.ToString("dd/MM/yyyy")
                </td>

                <td>
                    @item.DataPrevistaDevolucao.ToString("dd/MM/yyyy")
                </td>

                <td>
                    @if (item.DataDevolucao.HasValue)
                    {
                        @item.DataDevolucao.Value.ToString("dd/MM/yyyy")
                    }
                    else
                    {
                        <span>-</span>
                    }
                </td>

                <td>
                    @if (item.DataDevolucao.HasValue)
                    {
                        <span>Devolvido</span>
                    }
                    else
                    {
                        <span>Em curso</span>
                    }
                </td>

                <td>
                    <a asp-action="Details"
                       asp-route-id="@item.Id">
                        Detalhes
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>