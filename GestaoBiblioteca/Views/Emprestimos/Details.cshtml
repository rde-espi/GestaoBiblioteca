@model GestaoBiblioteca.Data.Entities.Emprestimo

@{
    ViewData["Title"] = "Detalhes do Empréstimo";
}

<h1>
    <i class="fa-solid fa-circle-info mr-2" aria-hidden="true"></i>
    Detalhes do Empréstimo
</h1>

<hr />

<dl class="row">
    <dt class="col-sm-3">Leitor</dt>
    <dd class="col-sm-9">@Model.Leitor?.Nome</dd>

    <dt class="col-sm-3">Livro</dt>
    <dd class="col-sm-9">@Model.Livro?.Titulo</dd>

    <dt class="col-sm-3">Data do Empréstimo</dt>
    <dd class="col-sm-9">@Model.DataEmprestimo.ToString("dd/MM/yyyy")</dd>

    <dt class="col-sm-3">Devolução Prevista</dt>
    <dd class="col-sm-9">@Model.DataPrevistaDevolucao.ToString("dd/MM/yyyy")</dd>

    <dt class="col-sm-3">Data de Devolução</dt>
    <dd class="col-sm-9">
        @if (Model.DataDevolucao.HasValue)
        {
            @Model.DataDevolucao.Value.ToString("dd/MM/yyyy")
        }
        else
        {
            <span>-</span>
        }
    </dd>

    <dt class="col-sm-3">Estado</dt>
    <dd class="col-sm-9">
        @if (Model.DataDevolucao.HasValue)
        {
            <span class="badge badge-success">
                <i class="fa-solid fa-check mr-1" aria-hidden="true"></i>
                Devolvido
            </span>
        }
        else
        {
            <span class="badge badge-warning">
                <i class="fa-solid fa-clock mr-1" aria-hidden="true"></i>
                Em curso
            </span>
        }
    </dd>
</dl>

<div>
    @if (!Model.DataDevolucao.HasValue)
    {
        <form asp-action="Devolver"
              asp-route-id="@Model.Id"
              method="post"
              class="d-inline">
            <button type="submit" class="btn btn-success">
                <i class="fa-solid fa-rotate-left mr-1" aria-hidden="true"></i>
                Devolver Livro
            </button>
        </form>
    }

    <a asp-action="Index" class="btn btn-secondary">
        <i class="fa-solid fa-arrow-left mr-1" aria-hidden="true"></i>
        Voltar
    </a>
</div>
