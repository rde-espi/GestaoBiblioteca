@{
    ViewData["Title"] = "Início";
}

<div class="text-center py-4">
    <h1 class="display-4">
        <i class="fa-solid fa-book-open text-primary mr-2" aria-hidden="true"></i>
        Gestão Biblioteca
    </h1>

    <p class="lead">
        Bem-vindo à Gestão Biblioteca. Consulte os livros disponíveis e acompanhe os seus empréstimos.
    </p>

    <div class="mt-4">
        <a asp-controller="Livros" asp-action="Index" class="btn btn-primary mr-2 mb-2">
            <i class="fa-solid fa-book mr-1" aria-hidden="true"></i>
            Ver Livros
        </a>

        @if (User.Identity != null && User.Identity.IsAuthenticated)
        {
            <a asp-controller="Emprestimos" asp-action="Index" class="btn btn-outline-primary mb-2">
                <i class="fa-solid fa-book-open-reader mr-1" aria-hidden="true"></i>
                Meus Empréstimos
            </a>
        }
        else
        {
            <a asp-controller="Account" asp-action="Login" class="btn btn-outline-primary mb-2">
                <i class="fa-solid fa-right-to-bracket mr-1" aria-hidden="true"></i>
                Iniciar Sessão
            </a>
        }
    </div>
</div>
