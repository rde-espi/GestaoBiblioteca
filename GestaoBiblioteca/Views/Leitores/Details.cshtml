@model GestaoBiblioteca.Data.Entities.Leitor

@{
    ViewData["Title"] = "Detalhes do Leitor";
}

<h1>
    <i class="fa-solid fa-circle-info mr-2" aria-hidden="true"></i>
    Detalhes do Leitor
</h1>

<hr />

<dl class="row">
    <dt class="col-sm-3">
        Nome
    </dt>
    <dd class="col-sm-9">
        @Model.Nome
    </dd>

    <dt class="col-sm-3">
        Email
    </dt>
    <dd class="col-sm-9">
        @Model.Email
    </dd>

    <dt class="col-sm-3">
        Telefone
    </dt>
    <dd class="col-sm-9">
        @Model.Telefone
    </dd>
</dl>

<div>
    <a asp-action="Edit"
       asp-route-id="@Model.Id"
       class="btn btn-primary">
        <i class="fa-solid fa-pen mr-1" aria-hidden="true"></i>
        Editar
    </a>

    <a asp-action="Index"
       class="btn btn-secondary">
        <i class="fa-solid fa-arrow-left mr-1" aria-hidden="true"></i>
        Voltar
    </a>
</div>