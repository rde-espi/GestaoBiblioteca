@model GestaoBiblioteca.Data.Entities.Leitor

@{
    ViewData["Title"] = "Eliminar Leitor";
}

<h1>Eliminar Leitor</h1>

<h3>Tem a certeza de que pretende eliminar este leitor?</h3>

<hr />

<dl class="row">
    <dt class="col-sm-3">
        Nome
    </dt>
    <dd class="col-sm-9">
        @Model.Nome
    </dd>

    <dt class="col-sm-3">
        Email
    </dt>
    <dd class="col-sm-9">
        @Model.Email
    </dd>

    <dt class="col-sm-3">
        Telefone
    </dt>
    <dd class="col-sm-9">
        @Model.Telefone
    </dd>
</dl>

<form asp-action="Delete">
    <input type="hidden" asp-for="Id" />

    <input type="submit"
           value="Eliminar"
           class="btn btn-danger" />

    <a asp-action="Index"
       class="btn btn-secondary">
        Voltar
    </a>
</form>