@model IEnumerable<GestaoBiblioteca.Data.Entities.Leitor>

@{
    ViewData["Title"] = "Leitores";
}

<h1>
    <i class="fa-solid fa-users mr-2" aria-hidden="true"></i>
    Leitores
</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">
        <i class="fa-solid fa-plus mr-1" aria-hidden="true"></i>
        Novo Leitor
    </a>
</p>

<div class="table-responsive">
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Nome</th>
                <th>Email</th>
                <th>Telefone</th>
                <th></th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Nome</td>
                    <td>@item.Email</td>
                    <td>@item.Telefone</td>
                    <td>
                        <a asp-action="Edit"
                           asp-route-id="@item.Id"
                           class="btn btn-sm btn-outline-primary mr-1">
                            <i class="fa-solid fa-pen mr-1" aria-hidden="true"></i>Editar
                        </a>

                        <a asp-action="Details"
                           asp-route-id="@item.Id"
                           class="btn btn-sm btn-outline-info mr-1">
                            <i class="fa-solid fa-eye mr-1" aria-hidden="true"></i>Detalhes
                        </a>

                        <a asp-action="Delete"
                           asp-route-id="@item.Id"
                           class="btn btn-sm btn-outline-danger">
                            <i class="fa-solid fa-trash mr-1" aria-hidden="true"></i>Eliminar
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>