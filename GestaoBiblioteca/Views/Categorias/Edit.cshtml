@model GestaoBiblioteca.Data.Entities.Categoria

@{
    ViewData["Title"] = "Editar Categoria";
}

<h1><i class="fa-solid fa-pen-to-square mr-2" aria-hidden="true"></i>Editar Categoria</h1>

<hr />

<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <input type="hidden" asp-for="Id" />

            <div class="form-group">
                <label asp-for="Nome" class="control-label"></label>
                <input asp-for="Nome" class="form-control" />
                <span asp-validation-for="Nome" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Descricao" class="control-label"></label>
                <textarea asp-for="Descricao" class="form-control"></textarea>
                <span asp-validation-for="Descricao" class="text-danger"></span>
            </div>

            <div class="form-group">
                <button type="submit" class="btn btn-primary">
                    <i class="fa-solid fa-floppy-disk mr-1" aria-hidden="true"></i> Guardar
                </button>

                <a asp-action="Index"
                   class="btn btn-secondary">
            <i class="fa-solid fa-arrow-left mr-1" aria-hidden="true"></i> Voltar
        </a>
            </div>

        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}