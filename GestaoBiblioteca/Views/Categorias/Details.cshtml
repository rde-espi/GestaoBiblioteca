@model GestaoBiblioteca.Data.Entities.Categoria

@{
    ViewData["Title"] = "Detalhes da Categoria";
}

<h1><i class="fa-solid fa-circle-info mr-2" aria-hidden="true"></i>Detalhes da Categoria</h1>

<hr />

<div>
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Nome)
        </dt>

        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Nome)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Descricao)
        </dt>

        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Descricao)
        </dd>
    </dl>
</div>

<div>
    <a asp-action="Edit"
       asp-route-id="@Model.Id"
       class="btn btn-primary">
        <i class="fa-solid fa-pen-to-square mr-1" aria-hidden="true"></i> Editar
    </a>

    <a asp-action="Index"
       class="btn btn-secondary">
            <i class="fa-solid fa-arrow-left mr-1" aria-hidden="true"></i> Voltar
        </a>
</div>