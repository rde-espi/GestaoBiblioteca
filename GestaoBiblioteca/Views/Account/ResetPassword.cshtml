@model GestaoBiblioteca.Models.ResetPasswordViewModel

@{
    ViewData["Title"] = "Redefinir palavra-passe";
}

<h2>Redefinir palavra-passe</h2>

<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="ResetPassword" method="post">

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <input asp-for="Token"
                   type="hidden"
                   value="@Context.Request.Query["token"]" />

            <div class="form-group">
                <label asp-for="UserName">Email</label>
                <input asp-for="UserName"
                       type="email"
                       class="form-control" />
                <span asp-validation-for="UserName" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Password">Nova palavra-passe</label>
                <input asp-for="Password" class="form-control" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="ConfirmPassword">Confirmar palavra-passe</label>
                <input asp-for="ConfirmPassword" class="form-control" />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>

            <div class="form-group">
                <button type="submit" class="btn btn-primary">
                    Redefinir palavra-passe
                </button>

                <a asp-action="Login" class="btn btn-secondary">
                    Voltar ao login
                </a>
            </div>

        </form>

        @if (ViewBag.Message != null)
        {
            <div class="alert alert-info mt-3">
                @ViewBag.Message
            </div>
        }
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}