@model IEnumerable<GestaoBiblioteca.Data.Entities.Livro>

@{
    ViewData["Title"] = "Livros";
}

<h1>
    <i class="fa-solid fa-book mr-2" aria-hidden="true"></i>
    Livros
</h1>

@if (User.IsInRole("Admin"))
{
    <a asp-action="Create" class="btn btn-primary mb-3">
        <i class="fa-solid fa-plus mr-1" aria-hidden="true"></i>
        Criar Novo Livro
    </a>
}
<div class="table-responsive">
<table class="table table-striped table-hover">
    <thead class="thead-light">
        <tr>
            <th>Capa</th>
            <th>Título</th>
            <th>Ano</th>
            <th>Categoria</th>
            <th>Autor(es)</th>
            <th>Disponível</th>
            <th></th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    <img src="@item.ImagemCapa"
                    alt="Capa de @item.Titulo" 
                    style="width: 55px; height: 80px; object-fit: contain;" 
                    loading="lazy" 
                    onerror="this.onerror=null;this.src='/images/noimage.jpg';" />
                </td>
                <td>
                    @item.Titulo
                </td>

                <td>
                    @item.AnoPublicacao
                </td>

                <td>
                    @item.Categoria?.Nome
                </td>

                <td>
                    @if (item.LivrosAutores != null && item.LivrosAutores.Any())
                    {
                        @string.Join(", ", item.LivrosAutores.Select(la => la.Autor.Nome))
                    }
                </td>

                <td>
                    @(item.Disponivel ? "Sim" : "Não")
                </td>

                <td>
                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary mb-1">
                            <i class="fa-solid fa-pen-to-square mr-1" aria-hidden="true"></i>
                            Editar
                        </a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger mb-1">
                            <i class="fa-solid fa-trash-can mr-1" aria-hidden="true"></i>
                            Eliminar
                        </a>
                    }
                    
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary mb-1">
                        <i class="fa-solid fa-eye mr-1" aria-hidden="true"></i>
                        Detalhes
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
</div>
