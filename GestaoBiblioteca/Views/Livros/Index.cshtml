@model IEnumerable<GestaoBiblioteca.Data.Entities.Livro>

@{
    ViewData["Title"] = "Livros";
}

<h1>Livros</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Novo Livro</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Título</th>
            <th>Capa</th>
            <th>Ano</th>
            <th>Categoria</th>
            <th>Autor(es)</th>
            <th>Disponível</th>
            <th></th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    <img src="@item.ImagemCapa"
                    alt="Capa de @item.Titulo" 
                    style="width: 55px; height: 80px; object-fit: contain;" 
                    loading="lazy" 
                    onerror="this.onerror=null;this.src='/images/noimage.png';" />
                </td>
                <td>
                    @item.Titulo
                </td>

                <td>
                    @item.AnoPublicacao
                </td>

                <td>
                    @item.Categoria?.Nome
                </td>

                <td>
                    @if (item.LivrosAutores != null && item.LivrosAutores.Any())
                    {
                        @string.Join(", ", item.LivrosAutores.Select(la => la.Autor.Nome))
                    }
                </td>

                <td>
                    @(item.Disponivel ? "Sim" : "Não")
                </td>

                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id">Editar</a> |
                    <a asp-action="Details" asp-route-id="@item.Id">Detalhes</a> |
                    <a asp-action="Delete" asp-route-id="@item.Id">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>