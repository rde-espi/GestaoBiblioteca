@model GestaoBiblioteca.Models.LivroViewModel

@{
    ViewData["Title"] = "Novo Livro";
}

<h1>
    <i class="fa-solid fa-book-circle-plus mr-2" aria-hidden="true"></i>
    Novo Livro
</h1>

<hr />

<div class="row">
    <div class="col-lg-11">
        <form asp-action="Create" enctype="multipart/form-data">

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="row">
                <div class="col-md-7">

                <div class="form-group">
                    <label asp-for="Livro.Titulo" class="control-label"></label>
                    <input asp-for="Livro.Titulo" class="form-control" />
                    <span asp-validation-for="Livro.Titulo" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label for="ImagemCapaUpload" class="control-label">
                        Imagem da capa
                    </label>

                    <input type="file"
                           id="ImagemCapaUpload"
                           name="ImagemCapaUpload"
                           class="form-control"
                           accept=".jpg,.jpeg,.png,.webp" />
                </div>


                <div class="form-group">
                    <label asp-for="Livro.AnoPublicacao" class="control-label">
                        Ano de Publicação
                    </label>
                    <input asp-for="Livro.AnoPublicacao" class="form-control" />
                    <span asp-validation-for="Livro.AnoPublicacao" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Livro.CategoriaId" class="control-label">
                        Categoria
                    </label>

                    <select asp-for="Livro.CategoriaId" class="form-control">
                        <option value="">Selecione uma categoria</option>

                        @foreach (var categoria in Model.Categorias)
                        {
                            <option value="@categoria.Id">
                                @categoria.Nome
                            </option>
                        }
                    </select>

                    <span asp-validation-for="Livro.CategoriaId" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label>Autor(es)</label>

                    @foreach (var autor in Model.Autores)
                    {
                        <div class="form-check">
                            <input class="form-check-input"
                                   type="checkbox"
                                   name="AutoresSelecionados"
                                   value="@autor.Id"
                                   id="autor_@autor.Id" />

                            <label class="form-check-label"
                                   for="autor_@autor.Id">
                                @autor.Nome
                            </label>
                        </div>
                    }
                    <span asp-validation-for="AutoresSelecionados" class="text-danger"></span>
                </div>

                <input type="hidden"
                       asp-for="Livro.Disponivel" />

                <div class="form-group">
                    <button type="submit" class="btn btn-primary">
                        <i class="fa-solid fa-plus mr-1" aria-hidden="true"></i>
                        Criar
                    </button>

                    <a asp-action="Index"
                       class="btn btn-secondary">
                        <i class="fa-solid fa-arrow-left mr-1" aria-hidden="true"></i>
                        Voltar
                    </a>
                </div>

                </div>

                <div class="col-md-5 text-center mt-3 mt-md-0">
                    <label class="d-block font-weight-bold">Pré-visualização da capa</label>

                    <img id="previewCapa"
                         src="@Model.Livro.ImagemCapa"
                         alt="Capa do livro"
                         class="img-thumbnail img-fluid"
                         style="width: 250px; max-width: 100%; max-height: 360px; object-fit: contain;"
                         onerror="this.onerror=null;this.src='/images/noimage.jpg';" />

                    <small class="form-text text-muted">
                        A imagem selecionada aparece aqui antes de guardar.
                    </small>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        document.getElementById("ImagemCapaUpload").addEventListener("change", function () {
            const imagem = document.getElementById("previewCapa");
            const ficheiro = this.files && this.files[0];

            if (!ficheiro) {
                imagem.src = imagem.dataset.original;
                return;
            }

            if (!["image/jpeg", "image/png", "image/webp"].includes(ficheiro.type) ||
                ficheiro.size > 2 * 1024 * 1024) {
                alert("Selecione uma imagem JPG, PNG ou WebP com até 2 MB.");
                this.value = "";
                imagem.src = imagem.dataset.original;
                return;
            }

            const leitor = new FileReader();

            leitor.onload = function (evento) {
                imagem.src = evento.target.result;
            };

            leitor.readAsDataURL(ficheiro);
        });

        document.getElementById("previewCapa").dataset.original =
            document.getElementById("previewCapa").src;
    </script>
}