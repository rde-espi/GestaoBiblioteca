@model GestaoBiblioteca.Data.Entities.Livro

@{
    ViewData["Title"] = "Detalhes do Livro";
}

<h1>Detalhes do Livro</h1>

<hr />

<dl class="row">
    <dt class="col-sm-3">
        Título
    </dt>
    <dd class="col-sm-9">
        @Model.Titulo
    </dd>

    <dt class="col-sm-3">
        Ano de Publicação
    </dt>
    <dd class="col-sm-9">
        @Model.AnoPublicacao
    </dd>

    <dt class="col-sm-3">
        Categoria
    </dt>
    <dd class="col-sm-9">
        @Model.Categoria?.Nome
    </dd>

    <dt class="col-sm-3">
        Autor(es)
    </dt>
    <dd class="col-sm-9">
        @if (Model.LivrosAutores != null && Model.LivrosAutores.Any())
        {
            @string.Join(", ", Model.LivrosAutores.Select(la => la.Autor.Nome))
        }
    </dd>

    <dt class="col-sm-3">
        Disponível
    </dt>
    <dd class="col-sm-9">
        @(Model.Disponivel ? "Sim" : "Não")
    </dd>
</dl>
<div class="mb-3">
    <img src="@Model.ImagemCapa"
         alt="Capa de @Model.Titulo"
         class="img-thumbnail"
         style="max-width: 180px; max-height: 260px; object-fit: contain;"
         onerror="this.onerror=null;this.src='/images/noimage.jpg';" />
</div>

<div>
    @if (User.IsInRole("Admin"))
{
    <a asp-action="Edit" asp-route-id="@Model.Id">Editar</a>
}

    <a asp-action="Index"
       class="btn btn-secondary">
        Voltar
    </a>
</div>