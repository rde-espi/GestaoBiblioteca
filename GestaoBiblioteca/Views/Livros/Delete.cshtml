@model GestaoBiblioteca.Data.Entities.Livro

@{
    ViewData["Title"] = "Eliminar Livro";
}

<h1>
    <i class="fa-solid fa-trash-can mr-2" aria-hidden="true"></i>
    Eliminar Livro
</h1>

<h3 class="text-danger">Tem a certeza de que pretende eliminar este livro?</h3>

<hr />

<dl class="row">
    <dt class="col-sm-3">
        Título
    </dt>
    <dd class="col-sm-9">
        @Model.Titulo
    </dd>

    <dt class="col-sm-3">
        Ano de Publicação
    </dt>
    <dd class="col-sm-9">
        @Model.AnoPublicacao
    </dd>

    <dt class="col-sm-3">
        Categoria
    </dt>
    <dd class="col-sm-9">
        @Model.Categoria?.Nome
    </dd>

    <dt class="col-sm-3">
        Autor(es)
    </dt>
    <dd class="col-sm-9">
        @if (Model.LivrosAutores != null && Model.LivrosAutores.Any())
        {
            @string.Join(", ", Model.LivrosAutores.Select(la => la.Autor.Nome))
        }
    </dd>

    <dt class="col-sm-3">
        Disponível
    </dt>
    <dd class="col-sm-9">
        @(Model.Disponivel ? "Sim" : "Não")
    </dd>
</dl>

<form asp-action="Delete">
    <input type="hidden" asp-for="Id" />

    <button type="submit" class="btn btn-danger">
                    <i class="fa-solid fa-trash-can mr-1" aria-hidden="true"></i>
                    Eliminar
                </button>

    <a asp-action="Index"
       class="btn btn-secondary">
                    <i class="fa-solid fa-arrow-left mr-1" aria-hidden="true"></i>
                    Voltar
                </a>
</form>