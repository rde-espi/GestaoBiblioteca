@model ErrorViewModel

@{
    ViewData["Title"] = "Erro";
}

@if (ViewBag.ErrorTitle == null)
{
    <h1 class="text-danger">Erro.</h1>
    <h2 class="text-danger">
        Ocorreu um erro ao processar o seu pedido.
    </h2>
}
else
{
    <h1 class="text-danger">
        @ViewBag.ErrorTitle
    </h1>

    <h2 class="text-danger">
        @Html.Raw(ViewBag.ErrorMessage)
    </h2>
}