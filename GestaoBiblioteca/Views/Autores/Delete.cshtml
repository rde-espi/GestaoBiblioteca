@model GestaoBiblioteca.Data.Entities.Autor

@{
    ViewData["Title"] = "Eliminar Autor";
}

<h1><i class="fa-solid fa-user-xmark mr-2" aria-hidden="true"></i>Eliminar Autor</h1>

<h3>Tem a certeza de que pretende eliminar este autor?</h3>

<hr />

<div>
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Nome)
        </dt>

        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Nome)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Nacionalidade)
        </dt>

        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Nacionalidade)
        </dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />

        <button type="submit" class="btn btn-danger">
                    <i class="fa-solid fa-trash mr-1" aria-hidden="true"></i> Eliminar
                </button>

        <a asp-action="Index"
           class="btn btn-secondary">
            <i class="fa-solid fa-arrow-left mr-1" aria-hidden="true"></i> Voltar
        </a>
    </form>
</div>
