@model GestaoBiblioteca.Data.Entities.Autor

@{
    ViewData["Title"] = "Novo Autor";
}

<h1><i class="fa-solid fa-user-plus mr-2" aria-hidden="true"></i>Novo Autor</h1>

<hr />

<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="Nome" class="control-label"></label>
                <input asp-for="Nome" class="form-control" />
                <span asp-validation-for="Nome" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Nacionalidade" class="control-label"></label>
                <input asp-for="Nacionalidade" class="form-control" />
                <span asp-validation-for="Nacionalidade" class="text-danger"></span>
            </div>

            <div class="form-group">
                <button type="submit" class="btn btn-primary">
                    <i class="fa-solid fa-plus mr-1" aria-hidden="true"></i> Criar
                </button>

                <a asp-action="Index"
                   class="btn btn-secondary">
                    <i class="fa-solid fa-arrow-left mr-1" aria-hidden="true"></i> Voltar
                </a>
            </div>

        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
