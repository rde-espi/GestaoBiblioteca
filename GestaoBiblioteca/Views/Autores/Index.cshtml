@model IEnumerable<GestaoBiblioteca.Data.Entities.Autor>

@{
    ViewData["Title"] = "Autores";
}

<h1><i class="fa-solid fa-users mr-2" aria-hidden="true"></i>Autores</h1>

<p>
    <a asp-action="Create" class="btn btn-primary"><i class="fa-solid fa-plus mr-1" aria-hidden="true"></i> Novo Autor</a>
</p>

<div class="table-responsive">
    <table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>
                Nome
            </th>
            <th>
                Nacionalidade
            </th>
            <th></th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @item.Nome
                </td>
                <td>
                    @item.Nacionalidade
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary mr-1"><i class="fa-solid fa-pen-to-square mr-1" aria-hidden="true"></i>Editar</a>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info mr-1"><i class="fa-solid fa-eye mr-1" aria-hidden="true"></i>Detalhes</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger mr-1"><i class="fa-solid fa-trash mr-1" aria-hidden="true"></i>Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
    </table>
</div>
